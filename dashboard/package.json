{
  "name": "tamga-dashboard",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib hooks",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:api-types": "openapi-typescript ../proxy/docs/openapi.yaml -o ./lib/api-types.generated.ts",
    "check:api-types": "npm run gen:api-types && git diff --exit-code lib/api-types.generated.ts"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.90.0",
    "@carbon/react": "^1.118.0",
    "@carbon/styles": "^1.117.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.60.0",
    "@uiw/react-codemirror": "^4.25.12",
    "motion": "^14.0.0",
    "next": "^15.0.0",
    "nuqs": "^2.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^4.1.8",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
